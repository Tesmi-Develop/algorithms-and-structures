        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Record\Record.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="texts.txt" />
